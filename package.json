{
  "name": "yway-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "agent:doctor": "node --import tsx scripts/agent-doctor.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "content:schemas": "node --import tsx scripts/content-generate-schemas.ts",
    "content:schemas:check": "node --import tsx scripts/content-generate-schemas.ts --check",
    "verify:fast": "node --import tsx scripts/run-verification.ts fast",
    "verify:full": "node --import tsx scripts/run-verification.ts full",
    "verify:invariants": "node --import tsx scripts/check-product-invariants.ts",
    "verify:docs": "node --import tsx scripts/check-doc-consistency.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
