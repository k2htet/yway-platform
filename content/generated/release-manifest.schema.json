{
  "$comment": "Derived from the runtime Zod schemas in content/schemas/. Expressible governance conditionals are included under allOf. Rules JSON Schema cannot express (cross-array ID uniqueness, cross-field equality, date-window ordering) are enforced only by runtime Zod validation; use the runtime validators for full governance checks.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "packId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "packVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fixtureOnly": {
      "type": "boolean"
    },
    "classification": {
      "type": "string",
      "enum": [
        "fixture",
        "production"
      ]
    },
    "releasedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "bundle": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:\\/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "digest"
      ],
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "properties": {
        "founderApproved": {
          "type": "boolean",
          "const": true
        },
        "practitionerApproved": {
          "type": "boolean",
          "const": true
        },
        "localizationApproved": {
          "type": "boolean",
          "const": true
        },
        "accessibilityApproved": {
          "type": "boolean",
          "const": true
        },
        "sponsorship": {
          "type": "string",
          "enum": [
            "disclosed",
            "not-applicable"
          ]
        },
        "localizedContentDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtimeAccessibilityDeferred": {
          "type": "boolean",
          "const": true
        },
        "targetUserComprehensionDeferred": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "founderApproved",
        "practitionerApproved",
        "localizationApproved",
        "accessibilityApproved",
        "sponsorship"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "packId",
    "packVersion",
    "contentDigest",
    "fixtureOnly",
    "classification",
    "releasedAt",
    "bundle",
    "gates"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "fixtureOnly"
        ],
        "properties": {
          "fixtureOnly": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "classification": {
            "const": "fixture"
          }
        }
      }
    }
  ]
}
