{
  "$comment": "Derived from the runtime Zod schemas in content/schemas/. Expressible governance conditionals are included under allOf. Rules JSON Schema cannot express (cross-array ID uniqueness, cross-field equality, date-window ordering) are enforced only by runtime Zod validation; use the runtime validators for full governance checks.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "packId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "packVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "locale": {
      "type": "string",
      "enum": [
        "my"
      ]
    },
    "fixtureOnly": {
      "type": "boolean"
    },
    "preview": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "headline",
        "description"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "limitations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "experiments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "timebox": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "whatToNotice": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reflection": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "nextFork": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "title",
          "question",
          "action",
          "timebox",
          "whatToNotice",
          "reflection",
          "nextFork"
        ],
        "additionalProperties": false
      }
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "const": "content"
        },
        "readingOrder": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "alternativeText": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "transcript": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "id",
              "reference",
              "alternativeText",
              "transcript"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "scope",
        "readingOrder"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "packId",
    "packVersion",
    "locale",
    "fixtureOnly",
    "preview",
    "title",
    "summary",
    "limitations",
    "experiments"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "properties": {
        "accessibility": {
          "type": "object",
          "properties": {
            "readingOrder": {
              "type": "array",
              "uniqueItems": true
            },
            "media": {
              "type": "array",
              "uniqueItems": true
            }
          }
        }
      }
    }
  ]
}
