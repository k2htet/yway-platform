{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "packId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "packVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "locale": {
      "type": "string",
      "enum": [
        "my"
      ]
    },
    "fixtureOnly": {
      "type": "boolean"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "experiments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "timebox": {
            "type": "string",
            "minLength": 1
          },
          "whatToNotice": {
            "type": "string",
            "minLength": 1
          },
          "reflection": {
            "type": "string",
            "minLength": 1
          },
          "nextFork": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "question",
          "action",
          "timebox",
          "whatToNotice",
          "reflection",
          "nextFork"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "packId",
    "packVersion",
    "locale",
    "fixtureOnly",
    "title",
    "summary",
    "limitations",
    "experiments"
  ],
  "additionalProperties": false
}
